meta {
  name: Generate Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/external/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
