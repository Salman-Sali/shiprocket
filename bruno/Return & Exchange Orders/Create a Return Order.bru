meta {
  name: Create a Return Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/external/orders/create/return
  body: json
  auth: inherit
}

body:json {
  {
    "order_id": "r121579B09ap3o",
    "order_date": "2021-12-30",
